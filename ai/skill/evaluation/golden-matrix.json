{
  "schemaVersion": "1.0",
  "status": "implementation-ready",
  "selection": {
    "primaryGoldenPage": "task-list",
    "secondaryCandidate": "settings-form",
    "rationale": "任务列表覆盖 R1、集合状态、Tab 遮挡与双端列表差异；设置表单覆盖键盘与返回，作为第二任务与扩展项。"
  },
  "sharedPageSpecs": [
    "ai/skill/page-spec/examples/task-list.valid.json",
    "ai/skill/page-spec/examples/settings-form.valid.json"
  ],
  "stateMatrix": {
    "requiredForPrimary": [
      "loading",
      "content",
      "empty",
      "error"
    ],
    "requiredForSecondary": [
      "content",
      "loading",
      "error",
      "success"
    ],
    "appearance": [
      "light",
      "dark"
    ],
    "text": [
      {
        "id": "default"
      },
      {
        "id": "large-ios",
        "value": "AX3"
      },
      {
        "id": "large-android",
        "value": "fontScale=1.3"
      }
    ],
    "contentLength": [
      "short",
      "long"
    ],
    "platformSpecific": [
      "system-back",
      "safe-area-or-insets",
      "keyboard",
      "scroll",
      "screen-reader"
    ]
  },
  "platforms": {
    "ios": {
      "page": "task-list",
      "implementation": "SwiftUI",
      "apiEvidenceMinimum": "example-compiled",
      "verificationCommands": [
        {
          "id": "ios-build-test",
          "command": "Scripts/ci.sh pr",
          "purpose": "xcodebuild build-for-testing + simulator unit tests; never use swift build/test as gate",
          "responsibility": "ios-dev",
          "executedInM0": false
        },
        {
          "id": "ios-demo",
          "command": "xcodebuild test -project Examples/WisdomUIDemo/WisdomUIDemo.xcodeproj -scheme WisdomUIDemo -destination \"<resolved-simulator-udid>\"",
          "purpose": "consumer demo smoke",
          "responsibility": "ios-dev",
          "executedInM0": false
        },
        {
          "id": "ios-snapshot-ui",
          "command": "resolved from current Xcode test plan / snapshot fixtures before M2",
          "purpose": "required snapshot/UI matrix",
          "responsibility": "ios-dev",
          "executedInM0": false,
          "requiresPinning": true
        }
      ],
      "platformChecks": [
        "系统返回与状态恢复",
        "Safe Area 底部留白不被 Tab 栏遮挡",
        "Dynamic Type AX3 不截断",
        "VoiceOver 焦点顺序与标签",
        "浅色/深色",
        "键盘与滚动（设置页）"
      ],
      "verifiedGate": "编译 + 规定快照/UI 矩阵 + 设计评审问题闭环；静态检查不得标 verified",
      "dirtyInputPolicy": "现有 5 个 dirty 文件隔离，不得混入构建输入或覆盖"
    },
    "android": {
      "page": "task-list",
      "implementation": "Jetpack Compose",
      "apiEvidenceMinimum": "example-compiled",
      "verificationCommands": [
        {
          "id": "android-build",
          "command": "./gradlew :wisdom-ui:apiCheck :wisdom-ui:assembleRelease :wisdom-ui:testDebugUnitTest",
          "purpose": "ABI + release compile + unit tests",
          "responsibility": "android-dev",
          "executedInM0": false
        },
        {
          "id": "android-abi-drift",
          "command": "./gradlew :wisdom-ui:apiDump && git diff --exit-code -- wisdom-ui/api/wisdom-ui.api",
          "purpose": "API baseline drift",
          "responsibility": "android-dev",
          "executedInM0": false
        },
        {
          "id": "android-screenshot",
          "command": "./gradlew :wisdom-ui:tasks --all | grep -i screenshot（由 android-dev 在 M3 首日固化真实任务名）",
          "purpose": "six-state screenshot",
          "responsibility": "android-dev",
          "executedInM0": false,
          "requiresPinning": true
        },
        {
          "id": "android-demo",
          "command": "./gradlew :demo:assembleRelease",
          "purpose": "consumer smoke",
          "responsibility": "android-dev",
          "executedInM0": false
        }
      ],
      "platformChecks": [
        "系统/预测式返回",
        "WindowInsets/IME",
        "fontScale 1.3 不截断",
        "TalkBack 焦点顺序与标签",
        "浅色/深色",
        "键盘与滚动（设置页）",
        "触控热区 48dp"
      ],
      "verifiedGate": "编译 + ABI + 规定截图/UI 矩阵 + 设计评审问题闭环；wisdomGate 不可用时不得伪报",
      "dirtyInputPolicy": "基线干净；流水线只读"
    }
  },
  "verificationResponsibilities": [
    {
      "layer": "Page Spec / lint",
      "owner": "core-dev",
      "evidence": "contract-selftest / M1 校验器报告",
      "canProve": "结构与允许组合",
      "cannotProve": "原生编译、视觉、交互"
    },
    {
      "layer": "Package structure / reproducibility",
      "owner": "core-dev",
      "evidence": "check / pack 报告与 checksums",
      "canProve": "包结构与哈希一致",
      "cannotProve": "宿主加载与原生行为"
    },
    {
      "layer": "iOS native compile / UI",
      "owner": "ios-dev",
      "evidence": "xcodebuild 与快照/UI 报告",
      "canProve": "SwiftUI 真实 API 与规定矩阵",
      "cannotProve": "Android 行为"
    },
    {
      "layer": "Android native compile / UI",
      "owner": "android-dev",
      "evidence": "Gradle、ABI、截图/UI 报告",
      "canProve": "Compose 真实 API 与规定矩阵",
      "cannotProve": "iOS 行为"
    },
    {
      "layer": "Consumer host load",
      "owner": "qa-verifier",
      "evidence": "干净环境安装/加载报告",
      "canProve": "声明宿主可加载与路由可用",
      "cannotProve": "设计质量"
    },
    {
      "layer": "Independent design review",
      "owner": "design lead（评审人不得是页面实现者）",
      "evidence": "人工设计评审表",
      "canProve": "信息架构、视觉重量、内容质量",
      "cannotProve": "编译"
    }
  ],
  "automatedTests": [
    "Page Spec 正例通过、反例按 code 失败",
    "canonical 组件存在且无平台类型泄漏",
    "loading/content/empty/error 按页面类型覆盖",
    "浅色/深色、默认/大字体、短/长文案分别出结果",
    "平台编译、ABI、快照/UI 命令退出码与日志归档",
    "生成包无死链、越界路径、敏感文件和手改"
  ],
  "manualReview": [
    "用户任务与信息架构",
    "主操作与视觉层级",
    "组件选择与组合",
    "密度、间距、内容层级",
    "平台原生性与双端语义一致（非像素强求）",
    "无障碍与内容质量"
  ],
  "m0ExecutionStatus": "未执行任何原生编译、快照、UI、真机或宿主加载；本矩阵只冻结责任与命令要求。"
}
