{
  "schemaVersion": "1.1",
  "profile": "cross-platform",
  "page": {
    "id": "settings-form",
    "intent": "修改家庭与个人偏好设置",
    "navigation": "detail",
    "contentPattern": "form",
    "primaryAction": "saveSettings",
    "sourceRefs": [
      "docs/specs/03-patterns.md#R2"
    ]
  },
  "states": [
    {
      "id": "content",
      "kind": "content"
    },
    {
      "id": "disabled",
      "kind": "disabled",
      "note": "没有可保存的改动时主操作禁用"
    }
  ],
  "regions": [
    {
      "id": "nav",
      "kind": "navigation",
      "component": "WDNavigationBar",
      "intent": "返回上一级"
    },
    {
      "id": "fields",
      "kind": "form",
      "component": "WDListSection",
      "intent": "分组设置项"
    },
    {
      "id": "save",
      "kind": "actions",
      "component": "WDButton",
      "variant": "filled",
      "action": "saveSettings",
