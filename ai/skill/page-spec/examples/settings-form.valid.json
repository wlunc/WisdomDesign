    {
      "id": "cancel",
      "kind": "actions",
      "component": "WDButton",
      "variant": "plain",
      "action": "discardSettings",
      "intent": "放弃修改（次级操作）"
    }
  ],
  "accessibility": {
    "title": "设置",
    "readingOrder": "visual-order",
    "focusReturn": "返回上一级后焦点回到设置入口",
    "announcements": [
      "设置已保存"
    ]
  },
  "acceptance": [
    "保存后返回上一级并提示",
    "无改动时保存禁用",
    "两个按钮的层级与 filled/plain 一致"
  ]
}
