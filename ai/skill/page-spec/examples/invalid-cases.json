    {
      "id": "multiple-primary-actions-derived",
      "expectedError": {
        "code": "MULTIPLE_PRIMARY_ACTIONS",
        "jsonPath": "/regions",
        "semantic": true
      },
      "spec": {
        "schemaVersion": "1.1",
        "page": {
          "id": "two-filled",
          "intent": "两个 filled 按钮",
          "navigation": "stackRoot",
          "contentPattern": "overview",
          "primaryAction": "doA"
        },
        "states": [
          {
            "id": "content",
            "kind": "content"
          }
        ],
        "regions": [
          {
            "id": "a",
            "kind": "actions",
            "component": "WDButton",
            "variant": "filled",
            "action": "doA"
          },
          {
            "id": "b",
            "kind": "actions",
            "component": "WDButton",
            "variant": "filled"
          }
        ],
        "accessibility": {
          "title": "检测"
        },
        "acceptance": [
          "可验证"
        ]
      },
      "note": "两个 filled 变体 → 两个 primary；这正是原规则的意图，只是现在按 variant 判而不是按 kind 数。"
    },
    {
      "id": "primary-action-not-connected",
      "expectedError": {
        "code": "PRIMARY_ACTION_NOT_CONNECTED",
        "jsonPath": "/page/primaryAction",
        "semantic": true
      },
      "spec": {
        "schemaVersion": "1.1",
        "page": {
          "id": "dangling",
          "intent": "主操作悬空",
          "navigation": "stackRoot",
          "contentPattern": "overview",
          "primaryAction": "deleteEverything"
        },
        "states": [
          {
            "id": "content",
            "kind": "content"
          }
        ],
        "regions": [
          {
            "id": "body",
            "kind": "collection",
            "component": "WDListSection"
          },
          {
            "id": "actions",
            "kind": "actions",
            "component": "WDButton",
            "variant": "filled",
            "action": "createTask"
          }
        ],
        "accessibility": {
          "title": "检测"
        },
        "acceptance": [
          "可验证"
        ]
      },
      "note": "actions 区存在但声明的是 createTask，而 page.primaryAction 是 deleteEverything —— 这是矛盾，不是隐式手势。原实现从不做这个交叉校验。"
    },
    {
      "id": "navigation-conflict-tab-root",
      "expectedError": {
        "code": "NAVIGATION_CONFLICT",
        "jsonPath": "/regions",
        "semantic": true
      },
      "spec": {
        "schemaVersion": "1.1",
        "page": {
          "id": "tab-root-navbar",
          "intent": "一级页带返回",
          "navigation": "tabRoot",
          "contentPattern": "overview",
          "primaryAction": "doThing"
        },
        "states": [
          {
            "id": "content",
            "kind": "content"
          }
        ],
        "regions": [
          {
            "id": "nav",
            "kind": "navigation",
            "component": "WDNavigationBar"
          },
          {
            "id": "body",
            "kind": "overview",
            "component": "WDCard",
            "action": "doThing"
          }
        ],
        "accessibility": {
          "title": "检测"
        },
        "acceptance": [
          "可验证"
        ]
      },
      "note": "tabRoot + WDNavigationBar 是自相矛盾组合；规格 §1 明写一级页面没有返回。"
    },
