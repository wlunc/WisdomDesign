{
  "description": "M0/M1 反例固定集。每个 case 必须按 expectedError.code 失败；M1 校验器应返回 code/jsonPath/message/suggestion。`semantic: true` 的用例由 runtime/validate-spec.js 判定（结构层检查器不实现语义规则，只由 schema-lite 校结构）。",
  "cases": [
    {
      "id": "unknown-component",
      "expectedError": {
        "code": "UNKNOWN_COMPONENT",
        "jsonPath": "/regions/0/component"
      },
      "spec": {
        "schemaVersion": "1.1",
        "page": {
          "id": "bad-component",
          "intent": "查看任务",
          "navigation": "tabRoot",
          "contentPattern": "collection",
          "primaryAction": "createTask"
        },
        "states": [
          {
            "id": "loading",
            "kind": "loading"
          },
          {
            "id": "content",
            "kind": "content"
          },
          {
            "id": "empty",
            "kind": "empty"
          },
          {
            "id": "error",
            "kind": "error"
          }
        ],
        "regions": [
          {
            "id": "tasks",
            "kind": "collection",
            "component": "WDFakeComponent",
            "itemPattern": "TaskRow"
          }
        ],
        "accessibility": {
          "title": "任务"
        },
        "acceptance": [
          "列表可读"
        ]
      }
    },
