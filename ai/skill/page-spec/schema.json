{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisdomdesign.local/ai-skill/page-spec/1.0/schema.json",
  "title": "WisdomDesign Page Spec v1",
  "description": "Platform-neutral page exchange contract. It excludes Swift/Kotlin/platform API types and is not a runtime UI VM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "page",
    "states",
    "regions",
    "accessibility",
    "acceptance"
  ],
  "x-semanticRules": {
    "NO_PRIMARY_ACTION": "page.primaryAction is required for the M0 golden-page profile; M1 validator assigns the code.",
    "PLATFORM_TYPE_LEAK": "regions[].component must be a canonical WD ID; platform-shaped strings are rejected by enum.",
    "COLLECTION_MISSING_EMPTY": "collection pages must include an empty state.",
    "UNKNOWN_COMPONENT": "regions[].component enum is the 37 canonical IDs from contracts.",
    "UNKNOWN_FIELD": "additionalProperties is false at every object level.",
    "INVALID_SCHEMA_VERSION": "schemaVersion const is 1.0."
  },
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "description": "Page Spec schema version, independent from Skill/Token/component-library versions."
    },
    "profile": {
      "type": "string",
      "description": "Optional frozen profile name; core, single-platform, or cross-platform.",
      "enum": [
        "core",
        "single-platform",
        "cross-platform"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intent",
        "navigation",
        "contentPattern",
        "primaryAction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "navigation": {
          "type": "string",
          "enum": [
            "tabRoot",
            "stackRoot",
            "detail",
            "modal"
          ]
        },
        "contentPattern": {
          "type": "string",
          "enum": [
            "collection",
            "form",
            "detail",
            "overview",
            "onboarding"
          ]
        },
        "primaryAction": {
          "type": "string",
          "description": "Stable business action ID, not a platform selector or API call.",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 20
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "loading",
              "content",
              "empty",
              "error",
              "success",
              "disabled",
              "unavailable",
              "custom"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "component"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "collection",
              "form",
              "detail",
              "overview",
              "actions",
              "feedback",
              "navigation",
              "custom"
            ]
          },
          "component": {
            "type": "string",
            "description": "Single canonical component or recipe ID; no platform types.",
            "enum": [
              "WDActionSheet",
              "WDAlert",
              "WDAssigneePicker",
              "WDAvatar",
              "WDAvatarStack",
              "WDBadge",
              "WDBanner",
              "WDBottomSheet",
              "WDButton",
              "WDCard",
              "WDCheckbox",
              "WDChip",
              "WDDatePicker",
              "WDDivider",
              "WDEmptyState",
              "WDFAB",
              "WDFormRow",
              "WDIcon",
              "WDIconButton",
              "WDListRow",
              "WDListSection",
              "WDNavigationBar",
              "WDPicker",
              "WDProgressBar",
              "WDProgressRing",
              "WDPullRefresh",
              "WDRadio",
              "WDSearchField",
              "WDSegmentedControl",
              "WDSkeleton",
              "WDSlider",
              "WDStepper",
              "WDSwitch",
              "WDTabBar",
              "WDTextField",
              "WDToast",
              "WDToolbar"
            ]
          },
          "itemPattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Z][a-zA-Z0-9]*$"
          },
          "intent": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "readingOrder": {
          "type": "string",
          "enum": [
            "visual-order",
            "custom"
          ]
        },
        "focusReturn": {
          "type": "string",
          "maxLength": 160
        },
        "announcements": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "uniqueItems": true
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "uniqueItems": true
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Platform-neutral policy overrides only; no Swift/Kotlin types or API calls.",
      "properties": {
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "textScalingRequired": {
          "type": "boolean"
        },
        "colorSchemes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "light",
              "dark"
            ]
          }
        }
      }
    },
    "platforms": {
      "type": "array",
      "description": "Optional platform status annotations. A single-platform task may omit Page Spec entirely; presence here is not required for code generation.",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "status"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android",
              "web"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "spec-only",
              "unsupported",
              "not-verified",
              "incompatible"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "page": {
            "required": [
              "contentPattern"
            ],
            "properties": {
              "contentPattern": {
                "const": "collection"
              }
            }
          }
        },
        "required": [
          "page"
        ]
      },
      "then": {
        "properties": {
          "states": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "empty"
                }
              }
            }
          }
        }
      }
    }
  ]
}