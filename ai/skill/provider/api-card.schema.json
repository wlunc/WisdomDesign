{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wisdomdesign.local/ai-skill/provider/1.0/api-card.schema.json",
  "title": "WisdomDesign Platform API Card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "component",
    "symbol",
    "evidence",
    "sourceRefs",
    "callShape"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "web"
      ]
    },
    "component": {
      "type": "string",
      "pattern": "^WD[A-Za-z]+$"
    },
    "canonicalParam": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "signature": {
      "type": "string",
      "maxLength": 500
    },
    "callShape": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "evidence": {
      "type": "string",
      "enum": [
        "contract-only",
        "discovered",
        "example-compiled",
        "template-verified"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 20
    },
    "compilation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        },
        "matrixRef": {
          "type": "string",
          "minLength": 1
        },
        "executed": {
          "type": "boolean"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "uniqueItems": true,
      "maxItems": 20
    }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence": { "const": "example-compiled" } }, "required": ["evidence"] },
      "then": {
        "required": ["compilation"],
        "properties": {
          "compilation": {
            "required": ["command", "exitCode", "executed"],
            "properties": {
              "executed": { "const": true },
              "exitCode": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "evidence": { "const": "template-verified" } }, "required": ["evidence"] },
      "then": {
        "required": ["compilation"],
        "properties": {
          "compilation": {
            "required": ["command", "exitCode", "executed", "matrixRef"],
            "properties": {
              "executed": { "const": true },
              "exitCode": { "const": 0 }
            }
          }
        }
      }
    }
  ]
}