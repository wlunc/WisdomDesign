{
  "$description": "Wisdom Design System · 设计令牌唯一真源（DTCG 格式）。v1.0 定稿：温和蓝，浅色版为主。原始层不直接用于界面，界面只用 semantic 层。本文件是 M0-1 令牌 schema 的一次性冻结变更集（21 行清单的 (a) 部分 + schemes 维度 + U12 = 32 槽位），冻结窗口只开一次：此后新增/改键名 = 二次 breaking，必须走变更集流程。",
  "$version": "1.0.0",

  "schemes": {
    "$description": "主题方案维度（M0-1 同批冻结，用户决策 #8 层一）。键 = scheme 名（小写 slug），值为该方案元数据；语义色值真源 = semantic.<同名>，两者键集合必须一致（生成器按 --schemes 逐套输出，并在 --check 里断言相等）。appearance 决定浅/深解析（深色变体 = 新 scheme 名 + appearance: dark）。新增品牌 = 追加一条 scheme + 在 semantic 下增同名一组，不改已有键。运行时只换「已生成」的 scheme（不重启进程、不进高频路径）；不支持运行时任意 token.json / 服务端下发 / 逐槽位任意覆盖。",
    "light": { "$value": { "appearance": "light", "semantic": "semantic.light", "isDefault": true } },
    "dark":  { "$value": { "appearance": "dark",  "semantic": "semantic.dark",  "isDefault": false } }
  },

  "color": {
    "$type": "color",

    "named": {
      "$description": "来自定稿色卡，按层位命名，方便和设计稿对照",
      "lake":      { "$value": "#B0D5DF", "$description": "湖水蓝 · 背景层" },
      "mist":      { "$value": "#7EC4CF", "$description": "天青 · 背景层" },
      "slate":     { "$value": "#4C8DAE", "$description": "群青 · 背景层 / 描边" },
      "cyan":      { "$value": "#1685A9", "$description": "石青 · 组件层" },
      "blue":      { "$value": "#1677B3", "$description": "天蓝 · 组件层 / 文字与图标" },
      "indigo":    { "$value": "#2A5CAA", "$description": "景泰蓝 · 深色版按钮终点" },
      "navy":      { "$value": "#065279", "$description": "靛蓝 · 按下态 / 深色模式" },
      "navy-deep": { "$value": "#1E3B7A", "$description": "海军蓝 · 深色模式表面" },
      "abyss":     { "$value": "#080F40", "$description": "海青 · 最深，仅深色模式备用" }
    },

    "derived": {
      "$description": "由色卡派生的填充与文字色，均已验证对比度",
      "fill-light-1": { "$value": "#8FCFDD", "$description": "浅色版按钮渐变起点" },
      "fill-light-2": { "$value": "#63BAD2", "$description": "浅色版按钮渐变终点（配 #0E3A55 深字 5.4:1）" },
      "fill-mid-1":   { "$value": "#4FB0C8", "$description": "小面积标记渐变起点" },
      "fill-mid-2":   { "$value": "#1685A9", "$description": "小面积标记渐变终点" },
      "text-on-soft": { "$value": "#123F5C", "$description": "背景层上的文字色" },
      "text-on-fill": { "$value": "#0E3A55", "$description": "浅色按钮上的文字色" }
    },

    "su": {
      "0":   { "$value": "#FFFFFF" },
      "50":  { "$value": "#F1F8FA" },
      "100": { "$value": "#E4F0F5" },
      "200": { "$value": "#D2E4EB" },
      "300": { "$value": "#B9D2DC" },
      "400": { "$value": "#8FA9B5" },
      "500": { "$value": "#6B8794" },
      "600": { "$value": "#3E5764" },
      "700": { "$value": "#2C4250" },
      "800": { "$value": "#1B2E38" },
      "900": { "$value": "#0A1B24" },
      "950": { "$value": "#061017" }
    }
  },

  "gradient": {
    "$type": "gradient",
    "$description": "不随外观变化的渐变。需要随深浅色变化的渐变放在 semantic.light/dark.gradient 下。",
    "mid":         { "$value": "linear-gradient(135deg,#4FB0C8 0%,#1685A9 100%)", "$description": "小面积标记：勾选、开关、圆点" },
    "destructive": { "$value": "linear-gradient(135deg,#B8564D 0%,#A94A42 100%)", "$description": "危险操作填充：删除按钮、左滑删除底。白字 4.7–5.6:1" },
    "sunrise":     { "$value": "linear-gradient(135deg,#FFE7C2 0%,#FFD2C4 100%)", "$description": "暖色点缀，仅用于插画与空状态" }
  },

  "wash": {
    "$type": "gradient",
    "$description": "页面色晕。三条径向叠加，几何固定（90% 62% at 12% -6% / 82% 58% at 92% 2% / 120% 74% at 58% 104%），深浅两态只换颜色与 alpha。数值 = 生效 alpha（净 alpha），渲染层不得再乘 opacity。不要放进 gradient 组：生成器的 collectGradients() 只认 linear-gradient。",
    "light": {
      "$value": "radial-gradient(90% 62% at 12% -6%,rgba(176,213,223,.23),transparent 62%),radial-gradient(82% 58% at 92% 2%,rgba(126,196,207,.16),transparent 64%),radial-gradient(120% 74% at 58% 104%,rgba(76,141,174,.06),transparent 68%)",
      "$description": "B23 读法 E。601×601 几何采样最暗点 #DFF0F3（L=0.8426），text.tertiary #4C616D = 5.53:1"
    },
    "dark": {
      "$value": "radial-gradient(90% 62% at 12% -6%,rgba(18,52,73,.30),transparent 62%),radial-gradient(82% 58% at 92% 2%,rgba(15,64,85,.20),transparent 64%),radial-gradient(120% 74% at 58% 104%,rgba(22,119,179,.08),transparent 68%)",
      "$description": "A2 定值。601×601 几何采样最亮点 #0E2F42（L=0.0249），text.tertiary #839EB0 = 5.00:1"
    }
  },

  "semantic": {
    "$description": "语义色。U12 槽位 = semantic.<scheme> 的叶子路径，共 32 个（M0-1 新增 text.disabled）；每个 scheme 一套、浅深成对，生成器 --check 断言计数 == 32 且两端一致。",
    "light": {
      "$type": "color",
      "bg": {
        "canvas":  { "$value": "#F1F8FA" },
        "grouped": { "$value": "#E8F2F7" }
      },
      "surface": {
        "card":         { "$value": "#FFFFFFF0", "$description": "96% 白，边缘干净，不再叠内高光与背景模糊" },
        "card-solid":   { "$value": "#FFFFFF" },
        "card-sunken":  { "$value": "#EDF6F9" },
        "tint":         { "$value": "#D9E9F3", "$description": "组件填充三级阶梯的中档（tonal）。配方：品牌蓝 #1677B3 @16% 叠 surface.card，由 build.js 的 assertTintRecipe() 逐年复算" },
        "glass":        { "$value": "#FFFFFFB3", "$description": "仅导航栏 / Tab 栏 / 材质演示" },
        "glass-strong": { "$value": "#FFFFFFDB" }
      },
      "text": {
        "primary":   { "$value": "#0A1B24" },
        "secondary": { "$value": "#3E5764" },
        "tertiary":  { "$value": "#4C616D", "$description": "B10 修正：原 #5B7784 在 canvas 上只有 4.43、在色晕最暗点 3.83，改为本值后最不利 5.53" },
        "disabled":  { "$value": "#6A7B85", "$description": "禁用态文字色槽（IOS-06 / 用户决策 #3 ⇒ U12 = 32 槽位）。默认执行项（D-13 色值待设计给值，先冻结、不缩表）：净色、不与 40% 叠加；实测最不利背景 surface.tint #D9E9F3 = 3.53:1、canvas 4.09:1，均 ≥ 3:1（非豁免下限）；被否决的「40% 不透明度」方案同底实测 2.49:1。比 text.tertiary 更淡一档、仍可辨识" },
        "on-light-primary":   { "$value": "#0A1B24", "$description": "深色端材质自适应到亮底时的字阶；浅色主题下与 text.primary 同值，仅为两端成对生成而存在" },
        "on-light-secondary": { "$value": "#3E5764", "$description": "同上；浅色主题下与 text.secondary 同值" },
        "on-light-tertiary":  { "$value": "#4C616D", "$description": "同上；浅色主题下与 text.tertiary 同值" },
        "on-soft":   { "$value": "#123F5C" },
        "on-fill":   { "$value": "#0E3A55" },
        "on-dark":   { "$value": "#FFFFFF" },
        "brand":     { "$value": "#1677B3" }
      },
      "border": {
        "hairline":        { "$value": "#0A1B2414" },
        "hairline-strong": { "$value": "#0A1B2429" },
        "glass-top":       { "$value": "#FFFFFFCC" }
      },
      "fill": {
        "field":   { "$value": "#0A1B240D" },
        "pressed": { "$value": "#0A1B2412" }
      },
      "status": {
        "success": { "$value": "#2A7F5C" },
        "info":    { "$value": "#1677B3" },
        "warning": { "$value": "#97651F" },
        "danger":  { "$value": "#B8564D" }
      },
      "status-soft": {
        "success": { "$value": "#E3F5EC" },
        "info":    { "$value": "#E1F0F8" },
        "warning": { "$value": "#FFF4DC" },
        "danger":  { "$value": "#FBE7E4" }
      },
      "gradient": {
        "$type": "gradient",
        "surface": { "$value": "linear-gradient(135deg,#B0D5DF 0%,#7EC4CF 100%)", "$description": "背景层。只配 text.on-soft 深字" },
        "fill":    { "$value": "linear-gradient(135deg,#8FCFDD 0%,#63BAD2 100%)", "$description": "按钮 / 芯片填充。配 text.on-fill 深字 5.4–6.9:1" }
      }
    },

    "dark": {
      "$type": "color",
      "bg": {
        "canvas":  { "$value": "#0A1B26", "$description": "A2 换族：H 208.1° → 203.6°，与 su.900 同族（Δ色相 ≤3°）" },
        "grouped": { "$value": "#0D2331", "$description": "A2 换族：H 206.2° → 203.3°" }
      },
      "surface": {
        "card":         { "$value": "#132836D1", "$description": "A2 换族：H 208.4° → 204.0°" },
        "card-solid":   { "$value": "#0C212D", "$description": "A2 换族：H 205.0° → 201.8°" },
        "card-sunken":  { "$value": "#0A1E2A", "$description": "A2 换族：H 204.7° → 202.5°" },
        "tint":         { "$value": "#123348", "$description": "组件填充三级阶梯的中档（tonal）。配方：品牌蓝 #1677B3 @16% 叠 surface.card，由 build.js 的 assertTintRecipe() 逐年复算" },
        "glass":        { "$value": "#0C202C9E", "$description": "B22：= material.regular.fillDark。基色由 #0A1A28 收到 #0C202C（H 202.5°，与深色族同族），α 54.9% → 62.0%" },
        "glass-strong": { "$value": "#0C202CC7", "$description": "B22：= material.thick.fillDark。基色由 #0C1E2E 收到 #0C202C" }
      },
      "text": {
        "primary":   { "$value": "#E6F1F6" },
        "secondary": { "$value": "#A4BCCB" },
        "tertiary":  { "$value": "#839EB0" },
        "disabled":  { "$value": "#6E8798", "$description": "禁用态文字色槽（IOS-06 / 用户决策 #3 ⇒ U12 = 32 槽位）。默认执行项（D-13 色值待设计给值，先冻结、不缩表）：净色、不与 40% 叠加；实测最不利背景 surface.tint #123348 = 3.50:1、canvas 4.66:1，均 ≥ 3:1；比 text.tertiary（#839EB0）更暗一档、仍可辨识" },
        "on-light-primary":   { "$value": "#0A1B24", "$description": "深色端材质自适应到亮底（B24）时使用；值引用浅色端 text.primary，由 contrast.js 断言两者相等" },
        "on-light-secondary": { "$value": "#3E5764", "$description": "同上，引用浅色端 text.secondary" },
        "on-light-tertiary":  { "$value": "#4C616D", "$description": "同上，引用浅色端 text.tertiary" },
        "on-soft":   { "$value": "#B0D5DF" },
        "on-fill":   { "$value": "#DCEEF4" },
        "on-dark":   { "$value": "#FFFFFF" },
        "brand":     { "$value": "#7EC4CF" }
      },
      "border": {
        "hairline":        { "$value": "#FFFFFF1A" },
        "hairline-strong": { "$value": "#FFFFFF2E" },
        "glass-top":       { "$value": "#FFFFFF29" }
      },
      "fill": {
        "field":   { "$value": "#FFFFFF12" },
        "pressed": { "$value": "#FFFFFF17" }
      },
      "status": {
        "success": { "$value": "#7FD3B4" },
        "info":    { "$value": "#8FC4E8" },
        "warning": { "$value": "#EFC683" },
        "danger":  { "$value": "#EDA79E" }
      },
      "status-soft": {
        "success": { "$value": "#0D2E24" },
        "info":    { "$value": "#0C2740" },
        "warning": { "$value": "#33260E" },
        "danger":  { "$value": "#3A211E" }
      },
      "gradient": {
        "$type": "gradient",
        "surface": { "$value": "linear-gradient(135deg,#123449 0%,#0F4055 100%)", "$description": "背景层。只配 text.on-soft 浅字" },
        "fill":    { "$value": "linear-gradient(135deg,#1677B3 0%,#2A5CAA 100%)", "$description": "按钮 / 芯片填充。白字 4.9–6.7:1" }
      }
    }
  },

  "typography": {
    "$type": "typography",
    "$description": "字阶。M0-1：letterSpacing 逐条显式给出（只有 overline 非 0，其余 0），单位 = pt/sp 等价、不随字号缩放（契约注释项，不建键）；生成物 WDTextStyle 第 4 参 = letterSpacing。",
    "family": {
      "sans":    { "$value": "SF Pro Text / Roboto Flex" },
      "rounded": { "$value": "SF Pro Rounded / MiSans" }
    },
    "largeTitle":  { "$value": { "fontSize": "34", "lineHeight": "41", "fontWeight": 700, "letterSpacing": "0" } },
    "title1":      { "$value": { "fontSize": "28", "lineHeight": "34", "fontWeight": 700, "letterSpacing": "0" } },
    "title2":      { "$value": { "fontSize": "22", "lineHeight": "28", "fontWeight": 600, "letterSpacing": "0" } },
    "title3":      { "$value": { "fontSize": "20", "lineHeight": "25", "fontWeight": 600, "letterSpacing": "0" } },
    "headline":    { "$value": { "fontSize": "17", "lineHeight": "22", "fontWeight": 600, "letterSpacing": "0" } },
    "body":        { "$value": { "fontSize": "17", "lineHeight": "22", "fontWeight": 400, "letterSpacing": "0" } },
    "callout":     { "$value": { "fontSize": "16", "lineHeight": "21", "fontWeight": 400, "letterSpacing": "0" } },
    "subheadline": { "$value": { "fontSize": "15", "lineHeight": "20", "fontWeight": 400, "letterSpacing": "0" } },
    "footnote":    { "$value": { "fontSize": "13", "lineHeight": "18", "fontWeight": 400, "letterSpacing": "0" } },
    "caption1":    { "$value": { "fontSize": "12", "lineHeight": "16", "fontWeight": 400, "letterSpacing": "0" } },
    "caption2":    { "$value": { "fontSize": "11", "lineHeight": "13", "fontWeight": 500, "letterSpacing": "0" } },
    "overline":    { "$value": { "fontSize": "12", "lineHeight": "16", "fontWeight": 500, "letterSpacing": "0.6" } }
  },

  "space": {
    "$type": "dimension",
    "1":  { "$value": "2" },
    "2":  { "$value": "4" },
    "3":  { "$value": "8" },
    "4":  { "$value": "12" },
    "5":  { "$value": "16" },
    "6":  { "$value": "20" },
    "7":  { "$value": "24" },
    "8":  { "$value": "32" },
    "9":  { "$value": "40" },
    "10": { "$value": "48" }
  },

  "radius": {
    "$type": "dimension",
    "xs":       { "$value": "8" },
    "sm":       { "$value": "10" },
    "md":       { "$value": "14" },
    "lg":       { "$value": "18" },
    "xl":       { "$value": "24" },
    "xxl":      { "$value": "32" },
    "full":     { "$value": "999" },
    "checkbox": { "$value": "9" },
    "fab":      { "$value": "19" }
  },

  "size": {
    "$type": "dimension",
    "$description": "M0-1 冻结：触控双键（ios 44 / android 48，一次性改名、不留过渡键 size.touch-target-min）；行高单值键 row-height.{comfortable,compact} = 60/44（两端同值 = 可见内容；Android 布局盒 48 = 44 + 上下各 2dp 透明内边距，由 Modifier.wdTouchTarget() 实现，不另立令牌键）。",
    "control": {
      "sm": { "$value": "32" },
      "md": { "$value": "44" },
      "lg": { "$value": "52" }
    },
    "touch-target-min-ios":     { "$value": "44", "$description": "U8 双键；iOS 只生成本端常量 WDSize.touchTargetMin，不得用作视觉尺寸" },
    "touch-target-min-android": { "$value": "48", "$description": "U8 双键；Android 只生成本端常量（热区 = 行布局盒 48）" },
    "row-height": {
      "$description": "案 B（用户裁决 D1）：可见内容两端同值；契约 WDListRow.height = max(密度下限, 槽位派生)；行距差异登记 F51（Android 布局盒 48 / iOS 44）",
      "comfortable": { "$value": "60" },
      "compact":     { "$value": "44" }
    },
    "card-padding": {
      "comfortable": { "$value": "16" },
      "compact":     { "$value": "12" }
    },
    "field-height":    { "$value": "46", "$description": "WDTextField 默认档盒高；所有变体/状态 = 46 ± 1dp（状态不得改变高度）" },
    "field-min-width": { "$value": "190" },
    "checkbox":        { "$value": "26" },
    "icon": {
      "sm": { "$value": "16" },
      "md": { "$value": "20" },
      "lg": { "$value": "24" },
      "xl": { "$value": "28" }
    },
    "avatar": {
      "xs":  { "$value": "20" },
      "sm":  { "$value": "28" },
      "md":  { "$value": "32" },
      "lg":  { "$value": "40" },
      "xl":  { "$value": "56" },
      "xxl": { "$value": "72" }
    },
    "sheet": {
      "$description": "弹层几何（M0-1）：detent 是屏高比例（number），其余为尺寸",
      "detent": {
        "$type": "number",
        "half":  { "$value": 0.5 },
        "large": { "$value": 0.92 }
      },
      "max-width":     { "$value": "480" },
      "corner-radius": { "$value": "32" },
      "handle": {
        "width":  { "$value": "36" },
        "height": { "$value": "5" }
      },
      "handle-top-offset": { "$value": "8", "$description": "iOS 用系统把手、几何不可定制，本组为 Android 出口 + F27 登记的同值项" }
    },
    "tabbar-height":   { "$value": "56" },
    "navbar-compact":  { "$value": "44" },
    "navbar-standard": { "$value": "56" }
  },

  "elevation": {
    "$type": "shadow",
    "$description": "带品牌色的柔和阴影，不用纯黑。深色模式退化为黑阴影。M0-1 出口键（数值不变，仅明确出口）：生成物 WDElevation 档位 = 0/1/2/3/brand → iOS e0/e1/e2/e3/brand、Android level0/level1/level2/level3/brand（同名档位、两端命名差异已登记 DIR-1）；Android 为近似映射（映射表 5 行，登记 F43），iOS 双层 shadow 为精确映射；禁止为多层阴影引入离屏层。",
    "0": { "$value": { "layers": [] } },
    "1": { "$value": { "layers": [
      { "x": "0", "y": "1",  "blur": "2",  "color": "#0A3C640A" },
      { "x": "0", "y": "6",  "blur": "16", "color": "#0A3C640F" }
    ] } },
    "2": { "$value": { "layers": [
      { "x": "0", "y": "2",  "blur": "6",  "color": "#0A3C640F" },
      { "x": "0", "y": "14", "blur": "32", "color": "#0A3C6417" }
    ] } },
    "3": { "$value": { "layers": [
      { "x": "0", "y": "8",  "blur": "20", "color": "#0A3C6417" },
      { "x": "0", "y": "28", "blur": "56", "color": "#0A3C6421" }
    ] } },
    "brand": { "$value": { "layers": [
      { "x": "0", "y": "6", "blur": "16", "color": "#1677B32E" }
    ] } }
  },

  "material": {
    "$description": "玻璃 = 模糊 + 半透明填充 + 顶部高光 + 外圈细线。四条缺一不可。仅用于导航栏、Tab 栏、浮层、材质演示；卡片用近实底，避免圆角边缘出现重影。",
    "ultraThin": { "$value": { "blur": "14", "fillLight": "#FFFFFF61", "fillDark": "#0C202C57" } },
    "thin":      { "$value": { "blur": "22", "fillLight": "#FFFFFF8A", "fillDark": "#0C202C7A" } },
    "regular":   { "$value": { "blur": "30", "fillLight": "#FFFFFFB3", "fillDark": "#0C202C9E" } },
    "thick":     { "$value": { "blur": "44", "fillLight": "#FFFFFFDB", "fillDark": "#0C202CC7" } },
    "tinted":    { "$value": { "blur": "30", "tint": "linear-gradient(135deg,#B0D5DF4D 0%,#7EC4CF3D 100%)" } },
    "sheen":     { "$value": { "gradient": "linear-gradient(100deg,transparent 18%,#FFFFFFA8 50%,transparent 82%)", "duration": "3800" } }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "时长，单位 ms。reduced = 减弱动态（Reduce Motion）档的统一时长。",
      "instant": { "$value": "100" },
      "fast":    { "$value": "160" },
      "base":    { "$value": "240" },
      "slow":    { "$value": "340" },
      "slower":  { "$value": "500" },
      "reduced": { "$value": "150", "$description": "Reduce Motion 档统一时长（iOS CR-10-5 / M0-1 清单第 12 行）；默认执行项 = 150（备选 160 未采用，待设计裁决 D-5/DF-14）" }
    },
    "spring": {
      "$description": "canonical = response(秒) + dampingRatio(ζ)。D6：键名 dampingFraction → dampingRatio；**不再存 stiffness**（由 μ = 1.0 派生：stiffness = μ·(2π/response)² ⇒ gentle 246.74 / snappy 503.55 / bouncy 223.80；文档 `12 §3.1.3` 的 503.65 / 223.72 是旧舍入值，以公式为准、±0.5 容差内；两端产物自行推导，逐令牌锁 μ 时只改配置）。禁用 massFactor。",
      "gentle": { "$value": { "response": 0.40, "dampingRatio": 0.85 } },
      "snappy": { "$value": { "response": 0.28, "dampingRatio": 0.82 } },
      "bouncy": { "$value": { "response": 0.42, "dampingRatio": 0.68 } }
    },
    "component": {
      "$description": "组件私有描画/节奏参数。12 键 = WDComponent 出口全集（AR-61）：归属规则 = 交互动效时长 → WDMotion，组件私有节奏 → WDComponent，禁止互相搬运。M0-1 新增 press-overlay-alpha / layout-break-font-scale 两键；其余 10 键值不变、仅补出口。",
      "press-scale":         { "$value": 0.97 },
      "press-overlay-alpha": { "$value": 0.06, "$description": "按下叠加层 alpha（AR-47）：drawRect(fill.pressed × 本值)，深浅同值；禁 ColorMatrix / renderEffect / graphicsLayer.alpha 三条" },
      "checkbox-press":      { "$value": 0.90 },
      "checkbox-draw":       { "$value": "260" },
      "checkbox-glow":       { "$value": "400" },
      "switch-knob":         { "$value": "300" },
      "switch-track":        { "$value": "260" },
      "progress-easeout":    { "$value": "3200" },
      "toast-in":            { "$value": "320" },
      "list-stagger":        { "$value": "20" },
      "skeleton-shimmer":    { "$value": "2200" },
      "layout-break-font-scale": { "$value": 1.3, "$description": "横排→竖排降级阈值（L4 / AR-53）：读取 LocalDensity.current.fontScale，禁写死 1.3f、禁读 Configuration.fontScale" }
    }
  },

  "state": {
    "$description": "交互状态视觉值（U6 状态优先级：disabled > loading > pressed > focused > hover > default）。F45：两端实现机制可不同（iOS 状态视觉值 + Android press-overlay 叠加），必须一致的是状态优先级与可辨识性。brightness/alpha 为百分数；ring-width 单位 pt/sp 等价。",
    "hover":    { "brightness": { "$type": "number", "$value": 98, "$description": "仅指针设备，亮度 98%" } },
    "pressed":  { "brightness": { "$type": "number", "$value": 96, "$description": "亮度 96%（配合 motion.component.press-scale）" } },
    "focus": {
      "ring-width": { "$type": "dimension", "$value": "3", "$description": "外扩 3pt 光环" },
      "ring-alpha": { "$type": "number", "$value": 32, "$description": "text.brand 32% 透明；对相邻色 ≥ 3:1" }
    },
    "disabled": { "alpha": { "$type": "number", "$value": 40, "$description": "元素级整体不透明度 40%；文字专用槽见 semantic.<scheme>.text.disabled（该槽不豁免对比度，不与本值叠加）" } }
  }
}
